# ==========================================
# Configurações do Banco de Dados (VPS)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TroquePorUmaSenhaForte123!
POSTGRES_DB=tomaseucontexto

# ==========================================
# Chave da API da Groq (Obrigatória)
# ==========================================
GROQ_API_KEY=gsk_sua_chave_aqui

# ==========================================
# Chave do Google Cloud Text-to-Speech (Opcional)
# Deixe vazio para usar síntese de voz nativa no dispositivo
# ==========================================
GOOGLE_TTS_API_KEY=

# ==========================================
# Endereço do Site / Domínio para o Caddy
# Use ":80" para acessar direto pelo IP da VPS (HTTP)
# Ou use "seudominio.com.br" para HTTPS automático via Let's Encrypt
# ==========================================
SITE_ADDRESS=seudominio.com

# Deixe vazio para usar o mesmo domínio/IP automaticamente via proxy reverso
EXPO_PUBLIC_API_URL=
